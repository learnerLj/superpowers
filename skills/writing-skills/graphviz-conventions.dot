digraph STYLE_GUIDE {
    // 用 Graphviz DSL 自身描述流程图样式

    subgraph cluster_node_types {
        label="节点类型与形状";

        "这是一个问题吗？" [shape=diamond];
        "执行一个动作" [shape=box];
        "git commit -m 'msg'" [shape=plaintext];
        "当前状态" [shape=ellipse];
        "停止：关键警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "流程开始" [shape=doublecircle];
        "流程完成" [shape=doublecircle];
    }

    subgraph cluster_edge_types {
        label="边的标签";

        "二元决策？" [shape=diamond];
        "是路径" [shape=box];
        "否路径" [shape=box];
        "二元决策？" -> "是路径" [label="是"];
        "二元决策？" -> "否路径" [label="否"];

        "多项选择？" [shape=diamond];
        "选项 A" [shape=box];
        "选项 B" [shape=box];
        "选项 C" [shape=box];
        "多项选择？" -> "选项 A" [label="条件 A"];
        "多项选择？" -> "选项 B" [label="条件 B"];
        "多项选择？" -> "选项 C" [label="其它"];

        "流程 A 完成" [shape=doublecircle];
        "流程 B 开始" [shape=doublecircle];
        "流程 A 完成" -> "流程 B 开始" [label="触发", style=dotted];
    }

    subgraph cluster_naming_patterns {
        label="命名规则";

        // 问题用问号；动作以动词开始；命令保持字面量；状态描述当前情形
        "应该执行 X 吗？" [shape=diamond];
        "编写测试" [shape=box];
        "grep -r 'pattern' ." [shape=plaintext];
        "测试正在失败" [shape=ellipse];
    }

    subgraph cluster_structure {
        label="流程结构模板";

        "触发：某事发生" [shape=ellipse];
        "初始检查？" [shape=diamond];
        "主要动作" [shape=box];
        "git status" [shape=plaintext];
        "再次检查？" [shape=diamond];
        "替代动作" [shape=box];
        "停止：不得这样做" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "处理完成" [shape=doublecircle];

        "触发：某事发生" -> "初始检查？";
        "初始检查？" -> "主要动作" [label="是"];
        "初始检查？" -> "替代动作" [label="否"];
        "主要动作" -> "git status";
        "git status" -> "再次检查？";
        "再次检查？" -> "处理完成" [label="正常"];
        "再次检查？" -> "停止：不得这样做" [label="有问题"];
        "替代动作" -> "处理完成";
    }

    subgraph cluster_shape_rules {
        label="形状选择";

        "正在选择形状" [shape=ellipse];
        "它是决策？" [shape=diamond];
        "使用 diamond" [shape=diamond, style=filled, fillcolor=lightblue];
        "它是命令？" [shape=diamond];
        "使用 plaintext" [shape=plaintext, style=filled, fillcolor=lightgray];
        "它是警告？" [shape=diamond];
        "使用 octagon" [shape=octagon, style=filled, fillcolor=pink];
        "它是入口或出口？" [shape=diamond];
        "使用 doublecircle" [shape=doublecircle, style=filled, fillcolor=lightgreen];
        "它是状态？" [shape=diamond];
        "使用 ellipse" [shape=ellipse, style=filled, fillcolor=lightyellow];
        "默认使用 box" [shape=box, style=filled, fillcolor=lightcyan];

        "正在选择形状" -> "它是决策？";
        "它是决策？" -> "使用 diamond" [label="是"];
        "它是决策？" -> "它是命令？" [label="否"];
        "它是命令？" -> "使用 plaintext" [label="是"];
        "它是命令？" -> "它是警告？" [label="否"];
        "它是警告？" -> "使用 octagon" [label="是"];
        "它是警告？" -> "它是入口或出口？" [label="否"];
        "它是入口或出口？" -> "使用 doublecircle" [label="是"];
        "它是入口或出口？" -> "它是状态？" [label="否"];
        "它是状态？" -> "使用 ellipse" [label="是"];
        "它是状态？" -> "默认使用 box" [label="否"];
    }

    subgraph cluster_examples {
        label="正确与错误示例";

        "测试失败" [shape=ellipse];
        "阅读错误信息" [shape=box];
        "可以复现？" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "绝不能忽略错误" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "测试失败" -> "阅读错误信息";
        "阅读错误信息" -> "可以复现？";
        "可以复现？" -> "git diff HEAD~1" [label="是"];

        bad_1 [label="出了问题", shape=box]; // 应为状态 ellipse
        bad_2 [label="修复它", shape=box];   // 太含糊
        bad_3 [label="检查", shape=box];     // 应为带问题的 diamond
        bad_4 [label="运行命令", shape=box]; // 应写精确命令并用 plaintext
        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}
